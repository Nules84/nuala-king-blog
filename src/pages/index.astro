---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="eyebrow">Writer · Artist · Educator</p>
				<h1>Nuala King</h1>
				<p class="welcome">
					Welcome. This is a home for my writing, creative work and ongoing
					exploration of our relationship with place, story and the living world.
				</p>
			</section>

			<section>
				<h2>About</h2>
				<p>
					My background is in architecture and adult education. My writing and
					creative practice explore Irish folklore, cultural memory, landscape
					and ecological belonging.
				</p>
				<p>
					I am particularly interested in how stories can reconnect us with
					the places we inhabit and help us imagine more reciprocal relationships
					with the natural world.
				</p>
			</section>

			<section>
				<h2>Selected work</h2>
				<ul class="work-list">
					<li>
						<strong>Writing &amp; publications</strong>
						<p>Essays, cultural writing and my contribution to <em>Dúchas</em>.</p>
					</li>
					<li>
						<strong>Art &amp; placemaking</strong>
						<p>Creative practice, community art and our connections with place.</p>
					</li>
					<li>
						<strong>Music &amp; song</strong>
						<p>Traditional singing and musical explorations, gathered here as they develop.</p>
					</li>
				</ul>
			</section>

			<section>
				<h2>Connect</h2>
				<p>
					Thank you for visiting. If my work resonates with you, or you would
					like to get in touch, you are very welcome to contact me.
				</p>
				<p>
					<a href="mailto:hello@nualaking.com">Email me</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
		line-height: 1.8;
	}

	.intro {
		padding: 2rem 0 3rem;
	}

	.eyebrow {
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	h1 {
		font-size: clamp(2.8rem, 8vw, 4.5rem);
		line-height: 1.1;
		margin: 0.5rem 0 1.5rem;
	}

	h2 {
		font-size: 1.5rem;
		margin-top: 2.5rem;
	}

	.welcome {
		font-size: 1.2rem;
		max-width: 600px;
	}

	.work-list {
		padding-left: 1.25rem;
	}

	.work-list li {
		padding: 0.5rem 0;
	}

	.work-list p {
		margin-top: 0.25rem;
	}

	a {
		text-underline-offset: 0.2em;
	}
</style>
