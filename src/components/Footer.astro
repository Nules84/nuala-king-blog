<footer>
	<p>© 2026 Nuala King. All rights reserved.</p>

	<a
		href="https://www.instagram.com/irishcountrycore/"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Irish Country Core on Instagram"
		class="instagram-link"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="28"
			height="28"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
		</svg>
	</a>
</footer>

<style>
	footer {
		padding: 2rem 1rem;
		text-align: center;
		background: #f5f6f8;
		color: #61759f;
	}

	footer p {
		margin: 0 0 1.5rem;
		font-size: 1.1rem;
	}

	.instagram-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #61759f;
		text-decoration: none;
	}

	.instagram-link:hover {
		color: #333;
	}
</style>
