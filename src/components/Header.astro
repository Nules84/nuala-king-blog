
---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="social-links">
			<a
				href="https://www.instagram.com/irishcountrycore/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Instagram — Irish Country Core"
			>
				Instagram — Irish Country Core
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a {
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a:hover {
		color: var(--accent);
	}

	.internal-links,
	.social-links {
		display: flex;
		align-items: center;
	}

	@media (max-width: 600px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
		}

		.internal-links,
		.social-links {
			justify-content: center;
		}
	}
</style>
